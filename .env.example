# ==============================================================================
# LLM Configuration
# ==============================================================================
OPENAI_API_KEY=sk-your-key-here
MODEL=gpt-5-mini
TEMPERATURE=0.4
# max response tokens
MAX_TOKENS=8192
# reasoning effort: disabled, none, low, medium, high (disabled = omit param entirely)
REASONING_EFFORT=disabled

# ==============================================================================
# Design and Path Configuration
# ==============================================================================
DESIGN_NAME=fifo
RUN_ID=fifo_run_1
WORK_DIR=./work/TEMP

# Use absolute paths
DASHBOARD_PATH=/absolute/path/to/dashboard.json
BASE_DIR=/absolute/path/to/data
DESIGN_CONTEXT=1    # enable access to rtl files

# ==============================================================================
# Simulator Configuration
# ==============================================================================
COMPILER=/opt/siemens/questasim/linux_x86_64
SIMULATOR=questasim   # questasim | verilator

# ==============================================================================
# Workflow Parameters (apply to all architectures)
# ==============================================================================
MAX_ITERATIONS=10        # max orchestrator/agent API requests
MAX_RETRIES=3            # consecutive compile or sim failures
MAX_NO_PROGRESS=5        # iterations with no coverage improvement
MAX_NO_TOOL_CALLS=2      # consecutive responses with no tool calls
SIM_RUNS=5
SIM_TIMEOUT=60
TESTPLAN=1
KEEP_LATEST_FAILURES=1   # latest failed verification-cycle pairs kept in context (v1 only)
RECURSION_LIMIT=400      # LangGraph recursion limit for the parent graph
NUM_FEEDBACK_HOLES=0     # priority coverage holes in feedback (0 = unbounded)
CONTEXT_WINDOW=128000    # token cap before forced finalize

# ==============================================================================
# Functional Coverage
# ==============================================================================
FUNCTIONAL_COVERAGE_ENABLED=0
FUNCTIONAL_COVERAGE_TARGET=100.0
FUNCTIONAL_COVERAGE_TESTBENCH=/absolute/path/to/tb_template.sv

# ==============================================================================
# Multi-Agent Architecture
# ==============================================================================
# v1   = single ReAct loop (legacy, baseline)              — graphs/react.py
# v2   = Orchestrator + persistent Design Expert + Generator — graphs/orc_exp_gen.py
# v2.1 = Orchestrator + Analyzer-Generator + CRT             — graphs/ag_crt.py
# v3   = Orchestrator + Iterative Test Generator (CRT/directed via mode)
#                                                            — graphs/orc_gen.py
ARCHITECTURE=v3

# Orchestrator model — used by v2, v2.1, v3 (defaults to MODEL when unset)
# ORCHESTRATOR_MODEL=gpt-4o

# v2 (Orchestrator-Expert-Generator):
# DESIGN_EXPERT_MODEL=gpt-4o
# TEST_GENERATOR_MODEL=gpt-4o-mini
# EXPERT_CONTEXT_LIMIT=100000

# v2.1 (Orchestrator → Analyzer-Generator + CRT):
# ANALYZER_GENERATOR_MODEL=gpt-4o   # defaults to DESIGN_EXPERT_MODEL then MODEL
# CRT_MODEL=gpt-4o-mini             # defaults to TEST_GENERATOR_MODEL then MODEL

# v3 (Orchestrator + Iterative Test Generator):
# Reuses TEST_GENERATOR_MODEL for the sub-agent (defaults to MODEL).
# Headline knob is GEN_MAX_ITERATIONS — see below.

# Shared sub-agent controls (v2, v2.1, v3):
# GEN_MAX_RETRIES=3       # max compile/sim failures per sub-agent dispatch
# MAX_GEN_PER_ITER=3      # max sub-agents per orchestrator iteration (advisory)

# v3-specific sub-agent controls:
# GEN_MAX_ITERATIONS=5      # max SUCCESSFUL coverage rounds per dispatch
# GEN_MAX_NO_PROGRESS=2     # stop dispatch early if its own coverage stalls
# GEN_MAX_NO_TOOL_CALLS=2   # inner-loop guard against text-only responses
# GEN_RECURSION_LIMIT=120   # LangGraph recursion limit for the inner agent

# ==============================================================================
# Console Log Level
# ==============================================================================
LOG_LEVEL=INFO       # DEBUG to include all api requests
LOG_TRUNCATE=0       # truncate long tool call results

# ==============================================================================
# Bypass simulator (CI / smoke tests)
# ==============================================================================
# TEST_MODE=1
