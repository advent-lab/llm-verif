# ==============================================================================
# LLM Configuration
# ==============================================================================
OPENAI_API_KEY=your-api-key-here
MODEL=gpt-4o-mini
TEMPERATURE=0.4
# max response tokens
MAX_TOKENS=8192
# reasoning effort: (disabled = omit param entirely)
REASONING_EFFORT=disabled

# ==============================================================================
# Design and Path Configuration
# ==============================================================================
DESIGN_NAME=fifo
RUN_ID=fifo_run_1
WORK_DIR=./work

# Use absolute paths
DASHBOARD_PATH=path/to/dashboard.json
BASE_DIR=path/to/data
DESIGN_CONTEXT=1    # enable access to rtl files

# ==============================================================================
# Simulator Configuration
# ==============================================================================
COMPILER=path/to/compiler/bin
SIMULATOR=questasim # verilator support planned
LM_LICENSE_FILE=simulator-license

# ==============================================================================
# Workflow Parameters
# ==============================================================================

MAX_ITERATIONS=10   # max api requests
MAX_RETRIES=3       # consecutive compile or sim failures
MAX_NO_PROGRESS=5   # iterations with no coverage improvement
MAX_NO_TOOL_CALLS=2  # consecutive responses with no tool calls
SIM_RUNS=5
SIM_TIMEOUT=60
TESTPLAN=1
KEEP_LATEST_FAILURES=1  # number of latest failed verification cycle pairs to keep in context for debugging
RECURSION_LIMIT=400
NUM_FEEDBACK_HOLES=0  # priority coverage holes in feedback (0 = unbounded/all)
CONTEXT_WINDOW=128000  # upper limit for context window length in tokens

# ==============================================================================
# Multi-Agent Architecture
# ==============================================================================
# ARCHITECTURE=v1  # v1 (single ReAct), v2 (Orchestrator-Expert-Generator),
#                  # or v2.1 (Orchestrator → Analyzer-Generator + CRT)
# ORCHESTRATOR_MODEL=gpt-4o  # LLM for orchestrator (all multi-agent architectures)

# v2 (Orchestrator-Expert-Generator):
# DESIGN_EXPERT_MODEL=gpt-4o          # LLM for persistent Design Expert
# TEST_GENERATOR_MODEL=gpt-4o-mini    # LLM for stateless Test Generator agents
# EXPERT_CONTEXT_LIMIT=100000         # token limit before expert context warning

# v2.1 (Orchestrator → Analyzer-Generator + CRT):
# ANALYZER_GENERATOR_MODEL=gpt-4o     # LLM for Analyzer-Generator agents (defaults to DESIGN_EXPERT_MODEL then MODEL)
# CRT_MODEL=gpt-4o-mini               # LLM for CRT agents (defaults to TEST_GENERATOR_MODEL then MODEL)

# Shared (v2 and v2.1):
# GEN_MAX_RETRIES=3    # max compile/sim failures per sub-agent dispatch
# MAX_GEN_PER_ITER=3   # max agents per orchestrator iteration

# ==============================================================================
# Console Log Level
# ==============================================================================
LOG_LEVEL=INFO      # DEBUG to include all api requests
LOG_TRUNCATE=0      # truncate long tool call results

# ==============================================================================
# Bypass simulator
# ==============================================================================
# TEST_MODE=1
