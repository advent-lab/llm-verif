# ---------------------------------------------------------------------------
# CovAgent runtime config. Copy to `.env` and edit.
#
#   priority: CLI flags > env vars (this file) > built-in defaults
#   load:     auto-loaded from `./.env` (override with `--env-file`)
#   inspect:  `covagent show-config`
# ---------------------------------------------------------------------------

# --- Secrets / installs (no COVAGENT_ prefix) ------------------------------
OPENAI_API_KEY=sk-ant-...
# QUESTA_PATH=/opt/siemens/questasim/linux_x86_64

# --- Run target ------------------------------------------------------------
COVAGENT_DESIGN=lfsr
COVAGENT_DASHBOARD=work/dashboard.json
COVAGENT_WORKSPACE=work/workspaces/default

# --- Mode / simulator ------------------------------------------------------
# mode:      functional | code
# simulator: questa | verilator | mock
COVAGENT_MODE=functional
COVAGENT_SIMULATOR=questa

# --- LLM -------------------------------------------------------------------
# 1 = use mock LLM (no API calls); 0 = use OpenAI
COVAGENT_MOCK_LLM=0
COVAGENT_ORCHESTRATOR_MODEL=gpt-5-mini
COVAGENT_AGENT_MODEL=gpt-5-mini
COVAGENT_INIT_MODEL=gpt-5-mini
COVAGENT_TEMPERATURE=0.0

# --- Coverage goal ---------------------------------------------------------
COVAGENT_GOAL_PCT=90.0
# COVAGENT_GOAL_PER_SCOPE_PCT=80.0

# --- Budget ----------------------------------------------------------------
COVAGENT_MAX_ITERATIONS=20
COVAGENT_MAX_DISPATCHES=100
COVAGENT_MAX_WALL_TIME_S=86400
COVAGENT_PER_DISPATCH_ATTEMPTS=5
